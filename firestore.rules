rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registered children collection for MPGA Dia das Crianças
    match /registered_children/{childId} {
      allow read: if true;
      allow create: if request.resource.data.sequenceNumber is number
                    && request.resource.data.sequenceNumber >= 1
                    && request.resource.data.sequenceNumber <= 999
                    && request.resource.data.childName is string
                    && request.resource.data.childName.size() > 0;
      allow update, delete: if true; // Allows management and seeding
    }

    // Sorteio state document for real-time synchronization between tablets/screens
    match /sorteio_state/{docId} {
      allow read, write: if true;
    }
  }
}
